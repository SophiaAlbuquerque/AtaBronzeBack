# Environment for Docker
NODE_ENV=production
PORT=3000

# Database (will be overridden by docker-compose)
DATABASE_URL="file:./data/prod.db"

# JWT
JWT_SECRET=production-secret-change-this-in-deployment
JWT_EXPIRES_IN=7d

# External APIs
BLING_API_KEY=your-bling-api-key
BLING_API_URL=https://api.bling.com.br/Api/v3

ASAAS_API_KEY=your-asaas-api-key
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_SANDBOX=false

CORREIOS_API_URL=https://cep.correios.com.br/api/v2
