# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/atabrinze_db?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# External APIs
BLING_API_KEY=your-bling-api-key
BLING_API_URL=https://api.bling.com.br/Api/v3

ASAAS_API_KEY=your-asaas-api-key
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_SANDBOX=true

CORREIOS_API_URL=https://cep.correios.com.br/api/v2

# Logging
LOG_LEVEL=info
