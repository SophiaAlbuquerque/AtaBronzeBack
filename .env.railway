# Railway Environment Variables Template
# Copy these to your Railway project environment variables

NODE_ENV=production
PORT=3000

# Railway will provide this automatically when you add PostgreSQL service
DATABASE_URL=postgresql://postgres:password@hostname:5432/railway

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# External APIs (configure as needed)
BLING_API_KEY=your-bling-api-key
BLING_API_URL=https://api.bling.com.br/Api/v3

ASAAS_API_KEY=your-asaas-api-key
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_SANDBOX=true

CORREIOS_API_URL=https://cep.correios.com.br/api/v2
